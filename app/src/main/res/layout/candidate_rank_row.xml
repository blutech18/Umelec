<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Candidate Data Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF">

        <!-- Left Border -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#D0D0D0"/>

        <!-- Col 1: Rank -->
        <TextView
            android:id="@+id/tvCandidateRank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#D0D0D0"/>

        <!-- Col 2: Candidate Name -->
        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start"
            />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#D0D0D0"/>

        <!-- Col 3: Total Votes -->
        <TextView
            android:id="@+id/tvCandidateTotalVotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#D0D0D0"/>
    </LinearLayout>

    <!-- Horizontal Divider (below row, to separate rows) - NOTE: This is NOT needed here
         because the template above already has the full table structure. We will rely on
         the existing table borders. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D0D0D0"/>

</LinearLayout>