<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".Login">
    <!-- 🔹 Back Arrow (now outside the white container) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white_background"
            android:contentDescription="back_button_content_description"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0098E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:stateListAnimator="@animator/button_press_animator"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 🔹 White Rounded Container for Registration -->
    <LinearLayout
        android:id="@+id/registerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/rounded_white_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <!-- Your registration form content goes here -->
        <TextView
            android:id="@+id/loginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Login"
            android:textColor="#313131"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- EMAIL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.App.TextInputLayout.Validation"
            app:boxBackgroundMode="outline"
            android:hint="Email"
            app:placeholderText="Enter Umak Email"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="#8C8CA1"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:paddingStart="50dp"
                android:textColor="#000000"
                android:fontFamily="@font/poppins_regular" />

        </com.google.android.material.textfield.TextInputLayout>




    <LinearLayout
            android:id="@+id/EmailRequirements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/reqEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Please use your UMak email (@umak.edu.ph)"
                android:textColor="#8C8CA1"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"/>

        </LinearLayout>

        <!-- PASSWORD -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.App.TextInputLayout.Validation"
            app:boxBackgroundMode="outline"
            android:hint="Password"
            app:placeholderText="Enter Password"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#8C8CA1"
            app:endIconMode="password_toggle"
            app:endIconTint="#8C8CA1"
            app:errorIconDrawable="@null">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:paddingStart="50dp"
                android:textColor="#000000"
                android:fontFamily="@font/poppins_regular"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <!-- Password requirements -->
        <LinearLayout
            android:id="@+id/PasswordRequirements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/reqPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#8C8CA1"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                />
        </LinearLayout>

        <!-- FORGOT PASSWORD -->
        <LinearLayout
            android:id="@+id/ForgotPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="5dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/ForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password_link"
                android:textColor="#00537A"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/button_press_animator"
                />
        </LinearLayout>



        <!-- Spacer View: This will push the button to the bottom -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/RegisterLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/RegisterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don’t have an account? "
                android:textColor="#4A4A68"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                />

            <TextView
                android:id="@+id/RegisterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_link"
                android:textColor="#00537A"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/button_press_animator"
                />

        </LinearLayout>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:text="Log in"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:background="@drawable/blue_rounded_button"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@animator/button_press_animator"

            />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>



