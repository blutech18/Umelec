<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFCFE"
    tools:context=".Profile">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/blue_rounded_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white_background"
            android:contentDescription="back_button_content_description"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0098E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-50dp"
            android:stateListAnimator="@animator/button_press_animator"/>

        <TextView
            android:id="@+id/NameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="32sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FAFCFE"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:layout_marginTop="-50dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    ---

    <LinearLayout
        android:id="@+id/profileCircleContainer"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/circle_gradient_outline_background"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="@+id/HeaderLayout"
        app:layout_constraintEnd_toEndOf="@+id/HeaderLayout"
        app:layout_constraintBottom_toBottomOf="@+id/HeaderLayout"
        android:layout_marginBottom="-40dp">

        <TextView
            android:id="@+id/profileAcronym"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CCIS"
            android:textSize="32sp"
            android:textColor="#313131"
            android:fontFamily="@font/montserrat_bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/GreetingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/HeaderLayout">

        <LinearLayout
            android:id="@+id/greetingTextLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:gravity="center_horizontal">
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 🔹 White Rounded Container for Registration -->
    <LinearLayout
        android:id="@+id/registerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/rounded_white_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="190dp"
        android:gravity="center_horizontal">

        <!-- Your registration form content goes here -->
        <TextView
            android:id="@+id/nameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_semi_bold"
            android:textColor="#0E0E2C" />

        <!-- Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:outlineProvider="bounds"
            android:clipToPadding="false"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/EmailValue"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="jluna.a12345678@gmail.com"
                android:textColor="#313131"
                android:textSize="16sp"
                android:textStyle="normal"
                android:fontFamily="@font/poppins_regular"/>
            <TextView
                android:id="@+id/moduleValue"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:text="module"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="normal"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <!-- END FIRST CONTENT CARD -->
        <!-- College -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/outline_for_profile"
            android:paddingVertical="20dp"
            android:outlineProvider="bounds"
            android:clipToPadding="false"
            android:layout_marginHorizontal="16dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/CollegeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="College: "
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/CollegeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text="College of Computing and Information Sciences (CCIS)"
                    android:textColor="#313131"
                    android:textSize="16sp"
                    android:textStyle="normal"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/CollegeLabel"
                    android:layout_marginStart="8dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
        <!-- END FIRST CONTENT CARD -->


        <!-- SPACE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/outline_for_profile"
            android:paddingVertical="20dp"
            android:outlineProvider="bounds"
            android:clipToPadding="false"
            android:layout_marginHorizontal="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/SpaceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Election Status: "
                    android:textSize="1sp"
                    android:textColor="#666666"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_regular"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/SpaceValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Eligible"
                    android:textColor="#333333"
                    android:textSize="1sp"
                    android:textStyle="normal"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/SpaceLabel"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- END FIRST CONTENT CARD -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/RegisterLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/CpassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Want to change password? "
                android:textColor="#4A4A68"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                />

            <TextView
                android:id="@+id/CpassButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/click_link"
                android:textColor="#00537A"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/button_press_animator"
                />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:paddingVertical="16dp"
            android:background="@drawable/blue_rounded_button"
            android:textAllCaps="false"
            android:fontFamily="@font/montserrat_bold"
            android:layout_marginHorizontal="50dp"
            android:layout_marginBottom="20dp"
            android:stateListAnimator="@animator/button_press_animator"
            />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>



