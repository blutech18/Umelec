<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFCFE"
    tools:context=".OfficialResults">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/Back_Button_Wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="back_button_content_description"
                android:src="@drawable/ic_arrow_back"
                app:tint="#00537A"
                android:stateListAnimator="@animator/button_press_animator"/>
        </FrameLayout>

        <TextView
            android:id="@+id/TallyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Official Results"
            android:textSize="32sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#313131"
            android:gravity="center_horizontal"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/Back_Button_Wrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ResultStatusContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="30dp"
        android:gravity="start"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/HeaderLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/ResultsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status text loading..."
            android:textSize="12sp"
            android:textColor="#313131"
            android:fontFamily="@font/poppins_regular"
            />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/ResultStatusContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:backgroundTint="#FAFCFE">

        <LinearLayout
            android:id="@+id/registerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/CandidateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_gray_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp"
                android:layout_marginHorizontal="20dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="-20dp"
                    android:layout_marginStart="-20dp"
                    android:layout_marginEnd="-20dp"
                    android:layout_marginBottom="-90dp"
                    android:background="@drawable/rounded_blue_gradient_bg" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="20dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/candidate_profile_photo"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:src="@android:drawable/sym_def_app_icon"
                        android:scaleType="centerCrop"
                        app:civ_border_width="2dp"
                        app:civ_border_color="#CCCCCC" />

                    <TextView
                        android:id="@+id/candidate_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jane Doe"
                        android:textSize="20sp"
                        android:textColor="#4A4A68"
                        android:fontFamily="@font/montserrat_semi_bold"/>

                    <TextView
                        android:id="@+id/candidate_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marketing Director"
                        android:textSize="16sp"
                        android:textColor="#8C8CA1"
                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:id="@+id/candidate_total_votes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="III - BCSAD"
                        android:textSize="16sp"
                        android:textColor="#8C8CA1"
                        android:fontFamily="@font/poppins_regular"/>

                </LinearLayout>

            </LinearLayout>



        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>