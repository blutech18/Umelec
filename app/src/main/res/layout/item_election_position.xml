<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/PositionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/rounded_gray_bg"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginHorizontal="20dp"
    android:outlineProvider="background"
    android:elevation="10dp"
    android:translationZ="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/PositionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[Position Title]"
            android:textSize="20sp"
            android:textColor="#313131"
            android:fontFamily="@font/montserrat_bold"/>

        <ImageView
            android:id="@+id/btnFaqEdit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="Edit Position"
            app:tint="#00537A" />

        <ImageView
            android:id="@+id/btnFaqRemove"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_remove"
            android:contentDescription="Remove Position"
            app:tint="#DC3545" />

    </LinearLayout>


    <TextView
        android:id="@+id/CandidatesNames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="• Candidate 1\n• Candidate 2"
        android:textSize="12sp"
        android:textColor="#313131"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginStart="50dp"/>

    <TextView
        android:id="@+id/WhatYearLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="- [Year Level]"
        android:textSize="12sp"
        android:textColor="#313131"
        android:fontFamily="@font/poppins_regular"/>

</LinearLayout>