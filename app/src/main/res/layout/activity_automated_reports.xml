<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFCFE"
    tools:context=".AutomatedReports">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/Back_Button_Wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="back_button_content_description"
                android:src="@drawable/ic_arrow_back"
                app:tint="#00537A"
                android:stateListAnimator="@animator/button_press_animator"/>
        </FrameLayout>

        <TextView
            android:id="@+id/ReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Automated Reports"
            android:textSize="32sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#313131"
            android:gravity="center_horizontal"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/Back_Button_Wrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ReportStatusContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="30dp"
        android:gravity="start"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/HeaderLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/ReportGeneratedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report Generated: "
                android:textSize="12sp"
                android:textColor="#313131"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:id="@+id/tvReportGeneratedDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[Date], [Time]"
                android:textSize="12sp"
                android:textColor="#313131"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ElectionPeriodLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Election Period: "
                android:textSize="12sp"
                android:textColor="#313131"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:id="@+id/tvStartElectionPeriodDates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[Start Date]"
                android:textSize="12sp"
                android:textColor="#313131"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" to "
                android:textSize="12sp"
                android:textColor="#313131"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:id="@+id/tvEndElectionPeriodDates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[End Date]"
                android:textSize="12sp"
                android:textColor="#313131"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/MasterPdfDlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_download"
                android:contentDescription="Download Icon"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/masterpdf_link"
                android:textSize="16sp"
                android:textColor="#4A4A68"
                android:fontFamily="@font/poppins_bold"/>
        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/ReportStatusContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:backgroundTint="#FAFCFE">


        <LinearLayout
            android:id="@+id/ReportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <View
                android:layout_width="match_parent"
                android:layout_marginHorizontal="20dp"
                android:layout_height="2dp"
                android:background="#8C8CA1" />

            <TextView
                android:id="@+id/OverallTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overall Turnout &amp; Demographics"
                android:textSize="20sp"
                android:textColor="#313131"
                android:fontFamily="@font/montserrat_semi_bold"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:id="@+id/VoteTurnoutCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_gray_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="20dp"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp">
                <TextView
                    android:id="@+id/VoteTurnoutCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voter Turnout"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="8dp"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ChartArea"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="24dp">

                    <com.example.umelec.DoughnutChartView
                        android:id="@+id/voterTurnoutChart"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="20dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_circle"
                            app:tint="#313131"
                            android:contentDescription="Color indicator for Not Yet Voted"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not yet Voted"
                            android:textSize="14sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_circle"
                            app:tint="#31D0AA"
                            android:contentDescription="Color indicator for Voted"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voted"
                            android:textSize="14sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvNotVotedPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="32sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/montserrat_semi_bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Students have \nnot yet Voted"
                            android:textSize="16sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.1"/>
                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvVotedPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="32sp"
                            android:textColor="#31D0AA"
                            android:fontFamily="@font/montserrat_semi_bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Students \nalready Voted"
                            android:textSize="16sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.1"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/VotedStudentsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_gray_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="20dp"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp">


                <LinearLayout
                    android:id="@+id/BarChartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvYAxisLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="100dp"
                            android:text="Year"
                            android:textSize="12sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"
                            android:rotation="90"
                            android:gravity="center"
                            android:layout_marginEnd="8dp"/>

                        <LinearLayout
                            android:id="@+id/BarArea"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <include layout="@layout/bar_item_template"
                                android:id="@+id/barItem1st"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"/>
                            <include layout="@layout/bar_item_template"
                                android:id="@+id/barItem2nd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"/>
                            <include layout="@layout/bar_item_template"
                                android:id="@+id/barItem3rd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"/>
                            <include layout="@layout/bar_item_template"
                                android:id="@+id/barItem4th"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"/>

                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvXAxisLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Number of Students Voted"
                        android:gravity="center_horizontal"
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginBottom="8dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvVotedStudentsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voted Students by Year"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="center"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Voted: "
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:id="@+id/tvTotalVotedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="34"
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/DemographicCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FAFCFE"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voted Demographic Turnout Rate"
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="center"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D0D0D0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Demographic Group"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="start"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Eligible"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Turnout Rate"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="end"
                        android:paddingEnd="8dp"
                        android:paddingStart="4dp"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D0D0D0"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Female"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="start"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:id="@+id/tvFemaleEligible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:id="@+id/tvFemaleTurnout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50%"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="end"
                        android:paddingEnd="8dp"
                        android:paddingStart="4dp"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D0D0D0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF">
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Male"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="start"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:id="@+id/tvMaleEligible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>

                    <TextView
                        android:id="@+id/tvMaleTurnout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50%"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="end"
                        android:paddingEnd="8dp"
                        android:paddingStart="4dp"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#D0D0D0"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D0D0D0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="4dp"
                    android:background="#FAFCFE">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Gender: "
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Female "
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:id="@+id/tvFemaleSummaryRate"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="[X%]"
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text=" / Male "
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:id="@+id/tvMaleSummaryRate"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="[Y%]"
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text=" Turnout"
                        android:textSize="12sp"
                        android:textColor="#313131"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>



            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginHorizontal="20dp"
                android:layout_height="2dp"
                android:background="#8C8CA1"
                android:layout_marginVertical="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verified Vote Counts Summary"
                android:textSize="20sp"
                android:textColor="#313131"
                android:fontFamily="@font/montserrat_semi_bold"
                android:layout_marginBottom="10dp"
                android:layout_gravity="left"
                android:layout_marginLeft="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Officially Declared Winners: "
                android:textSize="16sp"
                android:textColor="#313131"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="10dp"
                android:layout_gravity="left"
                android:layout_marginLeft="20dp"/>

            <LinearLayout
                android:id="@+id/DeclaredWinnersCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FAFCFE"
                android:layout_marginBottom="20dp"
                android:clipToPadding="false"
                android:layout_marginHorizontal="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D0D0D0"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#FFFFFF">

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#D0D0D0"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Candidate Name"
                            android:textSize="12sp"
                            android:textColor="#000000"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="start" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#D0D0D0"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Position"
                            android:textSize="12sp"
                            android:textColor="#000000"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#D0D0D0"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D0D0D0"/>


                    <LinearLayout
                        android:id="@+id/llWinnersRowsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D0D0D0"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPositionRanksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="20dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>