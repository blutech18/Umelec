<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFCFE"
    tools:context=".Leader_manage_voters_list">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/Back_Button_Wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="back_button_content_description"
                android:src="@drawable/ic_arrow_back"
                app:tint="#00537A"
                android:stateListAnimator="@animator/button_press_animator"/>
        </FrameLayout>

        <TextView
            android:id="@+id/TallyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Voter List"
            android:textSize="32sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#313131"
            android:gravity="center_horizontal"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/Back_Button_Wrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.core.widget.NestedScrollView
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/HeaderLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:backgroundTint="#FAFCFE">


        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/SearchVoters"
                    android:layout_width="0dp"
                    android:layout_weight="3"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    style="@style/Widget.App.TextInputLayout.NoRightCorners"
                    app:boxBackgroundMode="outline"
                    android:hint="Search Voter"
                    app:placeholderText="Enter Name or ID"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="#8C8CA1"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputVoter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="40dp"
                        android:inputType="text"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular" />

                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:layout_marginTop="3dp"
                    android:id="@+id/btnSearch"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="Search"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:background="@drawable/blue_rounded_button_right_round"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_bold"
                    android:stateListAnimator="@animator/button_press_animator"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- LEFT LAYOUT: Students Already Voted -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_gradient_bg"
                    android:gravity="center"
                    android:paddingVertical="5dp"
                    android:outlineProvider="background"
                    android:elevation="10dp"
                    android:translationZ="2dp"
                    android:layout_marginStart="20dp"
                    >

                    <!--  -->
                    <TextView
                        android:id="@+id/tvVoted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FAFCFE"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_semi_bold"/>

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voted"
                        android:textColor="#FAFCFE"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- RIGHT LAYOUT: Students Not Yet Voted -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_gradient_bg"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:paddingVertical="5dp"
                    android:outlineProvider="background"
                    android:elevation="10dp"
                    android:translationZ="2dp"
                    android:layout_marginEnd="20dp"
                    android:backgroundTint="#515167">

                    <!--  -->
                    <TextView
                        android:id="@+id/tvNotVoted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FAFCFE"
                        android:textSize="24sp"
                        android:fontFamily="@font/montserrat_semi_bold"/>

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unvoted"
                        android:textColor="#FAFCFE"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_marginHorizontal="20dp"
                android:layout_height="2dp"
                android:background="#8C8CA1" />

            <!-- i hid the layout for voter list -->

            <LinearLayout
                android:id="@+id/VoterItemLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="50dp"
                    android:gravity="center_vertical">

                    <!-- LEFT LAYOUT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <!-- Voter Name -->
                        <TextView
                            android:id="@+id/tvVoterName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voter Name"
                            android:textSize="16sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"/>

                        <!-- Sub-info: ID and Year -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvVoterID"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A12345678"
                                android:textSize="12sp"
                                android:textColor="#313131"
                                android:fontFamily="@font/poppins_regular"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" / "
                                android:textSize="12sp"
                                android:textColor="#313131"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"/>

                            <TextView
                                android:id="@+id/tvVoterYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3rd Year"
                                android:textSize="12sp"
                                android:textColor="#313131"
                                android:fontFamily="@font/poppins_regular"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- RIGHT LAYOUT -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/tvVotedStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voted"
                            android:textSize="16sp"
                            android:textColor="#313131"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:id="@+id/ivVotedCheck"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_toast_check"
                            android:contentDescription="Voted check icon"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="10dp"
                    android:background="#8C8CA1"/>
            </LinearLayout>




        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>