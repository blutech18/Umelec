<?xml version="1.0" encoding="utf-8"?>
<!-- This file now matches the vertical card structure defined in your main activity -->
<LinearLayout
    android:id="@+id/CandidateCard"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_gray_bg"
    android:padding="20dp"
    android:layout_marginBottom="20dp"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:outlineProvider="background"
    android:elevation="10dp"
    android:translationZ="2dp"
    android:layout_marginHorizontal="20dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="-20dp"
        android:layout_marginStart="-20dp"
        android:layout_marginEnd="-20dp"
        android:layout_marginBottom="-90dp"
        android:background="@drawable/rounded_blue_gradient_bg" />
    <!-- 1. Profile Picture and Candidate Info (Centered Block) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="20dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/candidate_profile_photo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:scaleType="centerCrop"
            app:civ_border_width="2dp"
            app:civ_border_color="#CCCCCC" />

        <TextView
            android:id="@+id/candidate_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jane Doe"
            android:textSize="20sp"
            android:textColor="#4A4A68"
            android:fontFamily="@font/montserrat_semi_bold"/>

        <TextView
            android:id="@+id/candidate_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marketing Director"
            android:textSize="16sp"
            android:textColor="#8C8CA1"
            android:fontFamily="@font/poppins_regular"/>

        <TextView
            android:id="@+id/candidate_total_votes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="III - BCSAD"
            android:textSize="16sp"
            android:textColor="#8C8CA1"
            android:fontFamily="@font/poppins_regular"/>

    </LinearLayout>

</LinearLayout>
