<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".Homepage">

    <!-- Header Content (Fixed at the top) -->
    <LinearLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/GreetingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/greetingTextLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/GreetingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello, "
                    android:textSize="32sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="#FAFCFE" />

                <TextView
                    android:id="@+id/NameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textSize="32sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="#FAFCFE" />
            </LinearLayout>

            <ImageView
                android:id="@+id/notificationIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Notification"
                app:tint="#FAFCFE"
                app:layout_constraintEnd_toStartOf="@id/profileIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/button_press_animator"/>

            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profile"
                app:tint="#FAFCFE"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/button_press_animator"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/UmelecTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voter"
            android:textSize="20sp"
            android:fontFamily="@font/montserrat_semi_bold"
            android:textColor="#FAFCFE" />
    </LinearLayout>

    <!-- Floating Election Info Card Container -->
    <LinearLayout
        android:id="@+id/FloatingCardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/HeaderLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ElectionInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_gray_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:outlineProvider="background"
            android:elevation="10dp"
            android:translationZ="1dp"
            android:layout_marginHorizontal="20dp">

            <TextView
                android:id="@+id/electionTitleValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UMak Student Council Elections"
                android:textSize="20sp"
                android:textColor="#313131"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat_semi_bold" />

            <TextView
                android:id="@+id/textNoElection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No election is currently scheduled."
                android:textSize="16sp"
                android:textColor="#666666"
                android:fontFamily="@font/poppins_regular"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/UpcomingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:visibility="visible">
                <TextView
                    android:id="@+id/textUpcoming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voting opens on "
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"/>

                <TextView
                    android:id="@+id/UpcomingDateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Date"
                    android:textColor="#666666"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>

            <TextView
                android:id="@+id/textElectionEnded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voting for this period has closed."
                android:textSize="16sp"
                android:textColor="#666666"
                android:fontFamily="@font/poppins_regular"
                android:visibility="visible"/>

            <LinearLayout
                android:id="@+id/OngoingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voting Period: "
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:id="@+id/votingPeriodValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="October 10 - 15, 2025"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: "
                        android:textSize="16sp"
                        android:textColor="#666666"
                        android:fontFamily="@font/poppins_regular"/>
                    <TextView
                        android:id="@+id/statusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:textSize="16sp"
                        android:textColor="#007F00"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVoteNow"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Vote Now"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@drawable/blue_rounded_button"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_bold"
                    android:stateListAnimator="@animator/button_press_animator"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Candidates Preview Card (MOVED TO MAIN CONSTRAINT LAYOUT) -->
    <LinearLayout
        android:id="@+id/CandidatesPreviewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_gray_bg"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="20dp"

        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="20dp"
        android:outlineProvider="background"
        android:elevation="10dp"
        android:translationZ="2dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/candidatesCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Candidates Preview"
                android:textSize="20sp"
                android:textColor="#313131"
                android:fontFamily="@font/montserrat_semi_bold"/>

            <TextView
                android:id="@+id/btnViewAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/view_link"
                android:textSize="16sp"
                android:textColor="#00537A"
                android:gravity="end"
                android:fontFamily="@font/poppins_bold"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/button_press_animator"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textNoCandidates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No candidates available at the moment."
            android:textSize="16sp"
            android:textColor="#666666"
            android:fontFamily="@font/poppins_regular"/>

        <TextView
            android:id="@+id/textCandidatesEnded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Election has ended."
            android:textSize="16sp"
            android:textColor="#666666"
            android:fontFamily="@font/poppins_regular"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/CandidateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnPrevCandidate"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Previous Candidate"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="#666666"/>

            <HorizontalScrollView
                android:id="@+id/candidateScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnPrevCandidate"
                app:layout_constraintEnd_toStartOf="@id/btnNextCandidate">

                <LinearLayout
                    android:id="@+id/candidateListContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                </LinearLayout>
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btnNextCandidate"
                android:layout_width="32dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Next Candidate"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="#666666"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- White Background Scrollable Content -->
    <LinearLayout
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="80dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/HeaderLayout"
        app:layout_constraintBottom_toTopOf="@id/FooterLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="0dp">

    </LinearLayout>

    <!-- Footer Navigation -->
    <LinearLayout
        android:id="@+id/FooterLayout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@drawable/footer"
        android:gravity="center"
        android:outlineProvider="background"
        android:elevation="20dp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="#0098E0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:background="@drawable/blue_rounded_button"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_vote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_vote"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vote"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_candidates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_candidates"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Candidates"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_results"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_results"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Results"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_faq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_faq"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAQs"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
