<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FAFCFE"
    android:layout_marginBottom="20dp"
    android:clipToPadding="false">

    <!-- 1. Card Title: Position Title -->
    <TextView
        android:id="@+id/PositionTitleVoteCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Position Title"
        android:textSize="18sp"
        android:textColor="#313131"
        android:fontFamily="@font/montserrat_semi_bold"
        android:layout_marginBottom="8dp"/>

    <!-- 2. Position Rank Table Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D0D0D0"/>

        <!-- A. Table Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#D0D0D0"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="Rank"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#D0D0D0"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="Candidate Name"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/poppins_regular"
                android:gravity="start" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#D0D0D0"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Votes"
                android:textSize="12sp"
                android:textColor="#000000"
                android:fontFamily="@font/poppins_regular"
                android:gravity="start" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#D0D0D0"/>
        </LinearLayout>

        <!-- Horizontal Divider (Below Header) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D0D0D0"/>

        <!-- ⭐️ Dynamic Content Container ⭐️ -->
        <LinearLayout
            android:id="@+id/llCandidateRankRowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
        <!-- ⭐️ End Dynamic Content Container ⭐️ -->

        <!-- Bottom Border (Closes the main table box)
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D0D0D0"/>-->

    </LinearLayout>

    <!-- 3. Abstention Counter -->
    <LinearLayout
        android:id="@+id/ReportAbstainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Abstentions Recorded: "
            android:textSize="12sp"
            android:textColor="#313131"
            android:fontFamily="@font/poppins_regular"/>

        <TextView
            android:id="@+id/AbstainVoteCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[votes]"
            android:textSize="12sp"
            android:textColor="#313131"
            android:fontFamily="@font/poppins_regular"/>
    </LinearLayout>

</LinearLayout>