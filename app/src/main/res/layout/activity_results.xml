<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".Results">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/FAQsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Election \nMonitoring"
            android:textSize="32sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FAFCFE"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/profileIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_profile"
            android:contentDescription="Profile"
            app:tint="#FAFCFE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/button_press_animator"/>

        <ImageView
            android:id="@+id/notificationIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_notification"
            android:contentDescription="Notification"
            app:tint="#FAFCFE"
            app:layout_constraintEnd_toStartOf="@id/profileIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/button_press_animator"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/FooterLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/ContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/TimeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_gradient_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:layout_marginHorizontal="20dp"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp">

                <LinearLayout
                    android:id="@+id/TimeCardHeaderLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_hourglass"
                        app:tint="@android:color/white"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/TimeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remaining time before the election"
                        android:textSize="20sp"
                        android:fontFamily="@font/montserrat_semi_bold"
                        android:textColor="@android:color/white"
                        android:gravity="center"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/TimeCardCountdownLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:baselineAligned="false"
                    app:layout_constraintTop_toBottomOf="@id/TimeCardHeaderLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvDaysValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textSize="32sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Days"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvHoursValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textSize="32sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hours"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvMinutesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50"
                            android:textSize="32sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Minutes"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvSecondsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50"
                            android:textSize="32sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seconds"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@android:color/white"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:id="@+id/CandidatesPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_gray_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="20dp"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp">
                <TextView
                    android:id="@+id/candidatesCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leading Preview"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/textNoCandidates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No candidates available at the moment."
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"/>

                <TextView
                    android:id="@+id/textCandidatesEnded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Election has ended."
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/CandidateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/btnPrevCandidate"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:src="@drawable/ic_chevron_left"
                        android:contentDescription="Previous Candidate"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:tint="#666666"/>

                    <HorizontalScrollView
                        android:id="@+id/candidateScrollView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/btnPrevCandidate"
                        app:layout_constraintEnd_toStartOf="@id/btnNextCandidate">

                        <LinearLayout
                            android:id="@+id/candidateListContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        </LinearLayout>
                    </HorizontalScrollView>

                    <ImageButton
                        android:id="@+id/btnNextCandidate"
                        android:layout_width="32dp"
                        android:layout_height="0dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Next Candidate"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:tint="#666666"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/TalliesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_gray_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="20dp"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp">
                <TextView
                    android:id="@+id/talliesCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tallies"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/talliesCardMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live tallies are available."
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTally"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="View Live Tally"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/blue_rounded_button"
                        android:textAllCaps="false"
                        android:fontFamily="@font/poppins_bold"
                        android:stateListAnimator="@animator/button_press_animator"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ResultsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_gray_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="20dp"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp">
                <TextView
                    android:id="@+id/officialResultsCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official Result"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:id="@+id/officialResultsCardMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The official and verified results are now available."
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnResult"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="View result"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/blue_rounded_button"
                        android:textAllCaps="false"
                        android:fontFamily="@font/poppins_bold"
                        android:stateListAnimator="@animator/button_press_animator"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ReceiptCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_gray_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@+id/FloatingCardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="20dp"
                android:outlineProvider="background"
                android:elevation="10dp"
                android:translationZ="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify My Vote Submission"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use the codes from your vote receipt (Email/PDF) to confirm your ballot's inclusion in the official count."
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginBottom="10dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutReferenceCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.App.TextInputLayout.Validation"
                    app:boxBackgroundMode="outline"
                    android:hint="Reference Code"
                    app:placeholderText="Enter Reference Code"
                    app:startIconTint="#8C8CA1"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/Code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/CodeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Reference Code is required."
                        android:textColor="#D32F2F"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"/>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayoutSignatureSnippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    style="@style/Widget.App.TextInputLayout.Validation"
                    app:boxBackgroundMode="outline"
                    android:hint="Digital Signature Snippet"
                    app:placeholderText="Enter Digital Signature Snippet"
                    app:startIconTint="#8C8CA1"
                    app:errorIconDrawable="@null">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputSignatureSnippet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#000000"
                        android:fontFamily="@font/poppins_regular" />

                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:id="@+id/SignatureSnippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/SignatureSnippetText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Digital Signature Snippet is required."
                        android:textColor="#D32F2F"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_regular"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Search"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/blue_rounded_button"
                        android:textAllCaps="false"
                        android:fontFamily="@font/poppins_bold"
                        android:stateListAnimator="@animator/button_press_animator"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0F7F0"
                android:layout_marginBottom="10dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/FooterLayout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@drawable/footer"
        android:gravity="center"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Home"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="12sp"
                android:textColor="#333333"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_vote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_vote"
                android:contentDescription="Vote"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vote"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_candidates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_candidates"
                android:contentDescription="Candidates"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Candidates"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_results"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_results"
                android:contentDescription="Results"
                app:tint="#0098E0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Results  "
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:background="@drawable/blue_rounded_button"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nav_faq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_faq"
                android:contentDescription="FAQs"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
