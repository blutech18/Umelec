<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".Castvote3">

    <!-- 1. Header Content (Fixed at the top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white_background"
            android:contentDescription="back_button_content_description"
            android:src="@drawable/ic_arrow_back"
            android:stateListAnimator="@animator/button_press_animator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0098E0" />
        <TextView
            android:id="@+id/setupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Step 3 of 3"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            android:layout_marginTop="30dp"/>

        <View
            android:id="@+id/progressBarBackground"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/progress_bar_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />
        <View
            android:id="@+id/progressBarFill"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:background="@drawable/progress_bar_fill_gradient"
            app:layout_constraintBottom_toBottomOf="@id/progressBarBackground"
            app:layout_constraintStart_toStartOf="@id/progressBarBackground"
            app:layout_constraintTop_toTopOf="@id/progressBarBackground"
            app:layout_constraintWidth_percent="0.999" />
        <TextView
            android:id="@+id/stepCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Cast your vote"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBarBackground"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="150dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/FooterButtonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/registerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/signatureTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign to confirm your vote"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/montserrat_semi_bold"
                android:textColor="#313131"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/signatureValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please sign inside the box below to verify your identity and confirm your ballot. Your signature will be securely attached to your vote."
                android:textSize="16sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="#313131"
                android:layout_marginBottom="24dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/signature_pad_background">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/dashed_border_box"/>

                <com.example.umelec.ConstrainedSignaturePad
                    android:id="@+id/signaturePad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:penColor="@android:color/black"
                    app:velocityFilterWeight="0.9"
                    app:maxWidth="3dp"
                    app:minWidth="1dp" />

            </RelativeLayout>
            <LinearLayout
                android:id="@+id/SignaturePadReq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:id="@+id/SignaturePadReqText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Signature Invalid. Please only sign inside the constraint box."
                    android:textColor="#D32F2F"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="32dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnClearSignature"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Clear Signature"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@drawable/blue_rounded_button"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_bold"
                    android:enabled="false"
                    android:stateListAnimator="@animator/button_press_animator"/>
            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/FooterButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_horizontal"
        android:elevation="8dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:text="Submit"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/blue_rounded_button"
            android:fontFamily="@font/poppins_bold"
            app:backgroundTint="@null"
            android:enabled="false"
            android:stateListAnimator="@animator/button_press_animator"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>