<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFCFE"
    tools:context=".Leader_electionsetup">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/HeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/Back_Button_Wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="back_button_content_description"
                android:src="@drawable/ic_arrow_back"
                app:tint="#00537A"
                android:stateListAnimator="@animator/button_press_animator"/>
        </FrameLayout>

        <TextView
            android:id="@+id/ReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Election Setup"
            android:textSize="32sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#313131"
            android:gravity="center_horizontal"
            android:maxLines="2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/Back_Button_Wrapper"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/WhiteContainerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_white_bg"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/HeaderLayout"
        app:layout_constraintBottom_toTopOf="@id/FooterButtonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:backgroundTint="#FAFCFE">


        <LinearLayout
            android:id="@+id/ReportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp"  >

            <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/AddTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            style="@style/Widget.App.TextInputLayout.Validation"
            app:boxBackgroundMode="outline"
            android:hint="Election Title"
            app:placeholderText="Enter Election Title"
            app:startIconTint="#8C8CA1"
            app:errorIconDrawable="@null"
            android:paddingHorizontal="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#515167"
                android:fontFamily="@font/poppins_regular" />

        </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:paddingHorizontal="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/SelectStartDateLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.App.TextInputLayout.Validation"
                    app:boxBackgroundMode="outline"
                    android:hint="Start Date"
                    app:placeholderText="Select Date"
                    app:startIconDrawable="@drawable/ic_date"
                    app:errorIconDrawable="@null"
                    app:startIconTint="#515167">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputStartDate"
                        android:paddingStart="40dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:maxLines="1"
                        android:textColor="#515167"
                        android:fontFamily="@font/poppins_regular" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/SelectStartTimeLayout"
                    android:layout_marginStart="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.App.TextInputLayout.Validation"
                    app:boxBackgroundMode="outline"
                    android:hint="Start Time"
                    app:placeholderText="Select Time"
                    app:startIconDrawable="@drawable/ic_time"
                    app:errorIconDrawable="@null"
                    app:startIconTint="#515167">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputStartTime"
                        android:paddingStart="40dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:maxLines="1"
                        android:textColor="#515167"
                        android:fontFamily="@font/poppins_regular" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/SelectEndDateLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.App.TextInputLayout.Validation"
                    app:boxBackgroundMode="outline"
                    android:hint="End Date"
                    app:placeholderText="Select Date"
                    app:startIconDrawable="@drawable/ic_date"
                    app:errorIconDrawable="@null"
                    app:startIconTint="#515167">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEndDate"
                        android:paddingStart="40dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:maxLines="1"
                        android:textColor="#515167"
                        android:fontFamily="@font/poppins_regular" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/SelectEndTimeLayout"
                    android:layout_marginStart="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.App.TextInputLayout.Validation"
                    app:boxBackgroundMode="outline"
                    android:hint="End Time"
                    app:placeholderText="Select Time"
                    app:startIconDrawable="@drawable/ic_time"
                    app:errorIconDrawable="@null"
                    app:startIconTint="#515167">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputEndTime"
                        android:paddingStart="40dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true"
                        android:maxLines="1"
                        android:textColor="#515167"
                        android:fontFamily="@font/poppins_regular" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/PositionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_white_outlined_bg"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:layout_marginHorizontal="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Positions"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:id="@+id/tvPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add at least 1 position"
                    android:textSize="16sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/poppins_regular"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/PositionListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start"
                    android:layout_marginTop="10dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnViewPosition"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="View Position"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/blue_rounded_button"
                        android:textAllCaps="false"
                        android:fontFamily="@font/poppins_bold"
                        android:stateListAnimator="@animator/button_press_animator" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ElectionSettingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_white_outlined_bg"
                android:padding="16dp"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:layout_marginHorizontal="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Election Settings"
                    android:textSize="20sp"
                    android:textColor="#313131"
                    android:fontFamily="@font/montserrat_semi_bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="top">
                        <TextView
                            android:id="@+id/tvTermsAgreementText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#313131"
                            android:textSize="16sp"
                            android:text="Enable Abstain Option (Allow voters to abstain from voting in a position.)" />

                    </LinearLayout>
                    <CheckBox
                        android:id="@+id/cbAgreeTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#0098E0"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="  Preview"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@drawable/blue_rounded_button"
                    android:textAllCaps="false"
                    android:fontFamily="@font/poppins_bold"
                    android:enabled="false"
                    android:drawableStart="@drawable/ic_preview"
                    android:drawableTint="#FFFFFF"
                    android:stateListAnimator="@animator/button_press_animator"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/FooterButtonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_horizontal"
        android:elevation="8dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="300dp"
            android:layout_height="55dp"
            android:text="Submit"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/blue_rounded_button"
            android:fontFamily="@font/poppins_bold"
            app:backgroundTint="@null"
            android:enabled="false"
            android:stateListAnimator="@animator/button_press_animator"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>