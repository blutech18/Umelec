rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is a leader
    function isLeader() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'LEADER';
    }
    
    // Users collection - users can read/write their own document
    match /users/{userId} {
      // Allow read/write if user is authenticated and the document ID matches their UID
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow leaders to read all users (for voter statistics)
      allow read: if isLeader();
      
      // Allow creation during registration (user might not have document yet)
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    
    // Password reset codes collection
    match /passwordResetCodes/{email} {
      // Allow unauthenticated access for password reset flow (user forgot password, so not logged in)
      // Note: Using email as document ID. Security is maintained by:
      // - Code expiration (10 minutes)
      // - One-time use (marked as used after verification)
      // - User must know the email address
      allow create, read: if true; // Allow anyone to create/read reset codes (for password reset)
      allow update: if true; // Allow updates to mark code as used
      allow delete: if request.auth != null; // Only authenticated users can delete
    }
    
    // Mail collection (for email triggers)
    match /mail/{mailId} {
      // Allow clients to create email documents for Trigger Email extension
      // Security is maintained by validating email structure
      // Note: Email format validation is handled by Trigger Email extension and SMTP server
      allow create: if request.resource.data.keys().hasAll(['to', 'message']) &&
                     request.resource.data.to is string &&
                     request.resource.data.to.size() > 0 && // Non-empty email
                     request.resource.data.message is map &&
                     request.resource.data.message.keys().hasAll(['subject', 'html']) &&
                     request.resource.data.message.subject is string &&
                     request.resource.data.message.subject.size() > 0 && // Non-empty subject
                     request.resource.data.message.html is string &&
                     request.resource.data.message.html.size() > 0; // Non-empty HTML
      
      // Allow read for authenticated users (optional, for debugging)
      allow read: if request.auth != null;
      
      // Don't allow updates or deletes from client (only create)
      allow update, delete: if false;
    }
    
    // Elections collection
    match /elections/{electionId} {
      // Allow authenticated users to read elections
      allow read: if request.auth != null;
      // Allow leaders to create and update elections
      allow create, update: if isLeader();
      // Don't allow deletes (elections should be marked inactive instead)
      allow delete: if false;
    }
    
    // Positions collection
    match /positions/{positionId} {
      // Allow authenticated users to read positions
      allow read: if request.auth != null;
      // Allow leaders to create, update, and delete positions
      allow write: if isLeader();
    }
    
    // Candidates collection
    match /candidates/{candidateId} {
      // Allow authenticated users to read candidates
      allow read: if request.auth != null;
      // Allow leaders to create and update candidates
      allow create, update: if isLeader();
      // Don't allow deletes (candidates should be marked inactive instead)
      allow delete: if false;
    }
    
    // Votes collection
    match /votes/{voteId} {
      // Users can create their own votes
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid;
      // Users can only read their own votes
      allow read: if request.auth != null && 
                   (resource.data.userId == request.auth.uid ||
                    request.auth.uid == resource.data.userId);
      // Allow leaders to read all votes (for vote statistics and tallies)
      allow read: if isLeader();
      // Users cannot update or delete votes (votes are immutable)
      allow update, delete: if false;
    }
    
    // Results collection (for election results/winners)
    match /results/{resultId} {
      // Allow authenticated users to read results
      allow read: if request.auth != null;
      // Only allow writes through Cloud Functions or admin
      allow write: if false;
    }
    
    // FAQs collection
    match /faqs/{faqId} {
      // Allow authenticated users to read FAQs
      allow read: if request.auth != null;
      // Allow leaders to create, update, and delete FAQs
      allow write: if isLeader();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Allow authenticated users to read notifications
      allow read: if request.auth != null;
      // Allow leaders to create REMINDER notifications
      allow create: if isLeader() && request.resource.data.type == 'REMINDER';
      // Allow users to create SUBMISSION notifications for themselves
      allow create: if request.auth != null && 
                     request.resource.data.type == 'SUBMISSION' &&
                     request.resource.data.targetUserId == request.auth.uid;
      // Allow users to update notifications (to mark as read)
      allow update: if request.auth != null;
      // Don't allow deletes
      allow delete: if false;
    }

    // Leader verification codes collection
    match /leaderVerificationCodes/{email} {
      // Allow leaders to create and read their own verification codes
      allow create, read, update: if request.auth != null && 
                                    request.auth.token.email == email &&
                                    isLeader();
      // Don't allow deletes (codes expire automatically)
      allow delete: if false;
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

